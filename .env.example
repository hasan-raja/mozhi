# Mozhi environment configuration
# Copy this file to .env and adjust values:  cp .env.example .env
# NEVER commit the real .env — it's already in .gitignore.

# ── App ─────────────────────────────────────────────
MOZHI_DEBUG=true

# ── Database ────────────────────────────────────────
# Local dev = docker-compose postgres. For AWS RDS later, swap host/user/pass:
# MOZHI_DATABASE_URL=postgresql+asyncpg://user:pass@mozhi-prod.xxx.rds.amazonaws.com:5432/mozhi?ssl=require
MOZHI_DATABASE_URL=postgresql+asyncpg://mozhi:mozhi@localhost:5432/mozhi

# ── Broker / cache ──────────────────────────────────
MOZHI_REDIS_URL=redis://localhost:6379/0

# ── ML engines (fill in when pipeline lands, Day 3) ─
# Primary: Sarvam API — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Fallback: OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Which engine set to use: sarvam | mock (mock = CI/loadtests, no keys needed)
MOZHI_ENGINE_MODE=mock
