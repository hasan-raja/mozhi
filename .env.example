# Mozhi environment configuration
# Copy this file to .env and adjust values:  cp .env.example .env
# NEVER commit the real .env — it's already in .gitignore.

# ── App ─────────────────────────────────────────────
MOZHI_DEBUG=true

# ── Database ────────────────────────────────────────
# Local dev = docker-compose postgres. For AWS RDS later, swap host/user/pass:
# MOZHI_DATABASE_URL=postgresql+asyncpg://user:pass@mozhi-prod.xxx.rds.amazonaws.com:5433/mozhi?ssl=require
MOZHI_DATABASE_URL=postgresql+asyncpg://mozhi:mozhi@localhost:5433/mozhi

# ── Broker / cache ──────────────────────────────────
MOZHI_REDIS_URL=redis://localhost:6379/0

# ── ML engines (fill in when pipeline lands, Day 3) ─
# Primary: Groq — https://console.groq.com/keys (free tier: 2M RPD)
GROQ_API_KEY=
# Fallback: OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Demo: Sarvam API — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Which engine set to use: local | groq | sarvam | mock
# local  = faster-whisper + Groq translate + edge-tts (dev default)
# groq   = explicit Groq translation mode
# sarvam = Sarvam APIs (demo/prod)
# mock   = CI/loadtests, no keys needed
MOZHI_ENGINE_MODE=local
